  "glossary": [
    {
      "id": "diagram-as-data",
      "term": "Diagram as data",
      "definition": "A diagram stored as a small JSON document (boxes, arrows, steps) instead of drawn art, so it can be edited, reviewed, exported and imported."
    },
    {
      "id": "flow-diagram",
      "term": "Flow diagram",
      "definition": "Boxes for the parties and arrows for the calls between them, in order. Each arrow is one message, so walking the arrows tells the story."
    },
    {
      "id": "walkthrough",
      "term": "Walkthrough",
      "definition": "Simulate highlights one arrow at a time, with Pause, Prev, Next and a speed control, so a presenter can pace the explanation."
    }
  ],
  "sources": [],
  "cards": [
    {
      "id": "edit",
      "label": "Edit and export",
      "description": "Add boxes and arrows, rename them, save a copy and export the diagram as JSON to share or re-import.",
      "group": "try-it",
      "terms": [
        "diagram-as-data"
      ],
      "action": {
        "type": "route",
        "href": "/"
      }
    },
    {
      "id": "studio",
      "label": "Diagram studio",
      "description": "Pick a flow diagram, drag the boxes, Simulate the arrows, change the speed, Reset, then save or export it.",
